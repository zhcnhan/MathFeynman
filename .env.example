# ===== YanHui 环境变量样例（复制为 .env 后填写） =====
# LLM（OpenAI 兼容，默认 DeepSeek；本地 ollama 亦兼容）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_HEAVY=deepseek-reasoner
LLM_MODEL_LIGHT=deepseek-chat
# 预算/成本开关（可选）：每日总 token 上限，超限自动降级
LLM_MAX_TOKENS_PER_DAY=

# ===== 材料注入预算（R37 S1 起语义已变；R38 起可在界面用两个滑块按学科调）=====
# MF_MATERIAL_INJECT_MAX_CHARS：**总注入上限**（0 = 不限，默认）。
#   R38 起界面把它呈现为"花费天花板"：实际超支只**记账 + 就地显示**，**不为满足它而丢章节**。
MF_MATERIAL_INJECT_MAX_CHARS=0
# MF_MATERIAL_BATCH_CHARS：**单次调用预算**（默认 60000）；超限**按章/页边界分批**（不截断句子）。
#   界面滑块档位：20000(省着用) / 60000(常规) / 150000(充裕) / 0(不限)。
MF_MATERIAL_BATCH_CHARS=60000
# 旧名（R36 D4）：仅在**显式设置**时生效；R37 起默认不再使用"前 N 字摘要"口径。
# MF_OUTLINE_MATERIAL_MAX_CHARS=0
# 扫描/图片版 PDF 判定（R37 S7）：每页平均字符数下限 / 有文字页占比下限
MF_MATERIAL_MIN_CHARS_PER_PAGE=40
MF_MATERIAL_MIN_TEXT_PAGE_RATIO=0.5
# R38 S1b：无标题/无目录 PDF **按页合并成"章级"单元**的目标大小（字符；0 = 关闭合并）
MF_PAGE_UNIT_CHARS=8000
# R38 A4：安全阀——按「字符 ≈ token」粗估的**模型上下文硬上限**；将超限则自动分批 + 中文说明
MF_CONTEXT_TOKEN_LIMIT=120000
# R42 B1：教材**过短条目**阈值（字符；默认 200）。
# 低于它的条目（标题/目录类）→ **并入相邻单元**或**标为跳过**，两者都进账本 + 覆盖账可解释。
MF_MIN_ENTRY_CHARS=200

# ===== AI 对话审计 / 提示词监听（R39 §3）=====
# 全文（渲染后 system/user + 原始返回）落盘目录；DB 只存路径 + 预览 + 字符数
MF_AI_TRACE_DIR=.runtime/ai_trace
# 保留期（天）：POST /api/ai-traces/cleanup 按它清理，**清理会记入总账**；
# R42 C3 起**后端启动时也会自动清理一次**（保留期同一变量）
MF_AI_TRACE_KEEP_DAYS=30

# 本地路径（可选，缺省有合理默认）
MF_DB_PATH=backend/data/yanhui.db
MF_CONTENT_ROOT=content
MF_HOST=127.0.0.1
MF_PORT=8000
MF_FRONT_PORT=5173

# ===== 外部检索后端（Phase C C1；默认未启用 = UI 标注"未配置检索后端"）=====
# 自托管 SearXNG（需实例开启 JSON 输出；免第三方 key）示例：
#   MF_SEARCH_PROVIDER=searxng
#   MF_SEARXNG_URL=http://127.0.0.1:8888
MF_SEARCH_PROVIDER=
MF_SEARXNG_URL=
MF_SEARCH_TIMEOUT_S=20
MF_SEARCH_MAX_ITEMS=8
MF_FETCH_PAGE_MAX_CHARS=200000
MF_FETCH_PAGE_TIMEOUT_S=15

# ===== PDF 上传解析（Phase C C2；pypdf）=====
MF_PDF_MAX_BYTES=20971520
MF_PDF_MAX_PAGES=400
MF_PDF_PER_PAGE_MAX_CHARS=8000
