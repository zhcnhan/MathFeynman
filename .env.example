# ===== MathFeynman 环境变量样例（复制为 .env 后填写） =====
# LLM（OpenAI 兼容，默认 DeepSeek；本地 ollama 亦兼容）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_HEAVY=deepseek-reasoner
LLM_MODEL_LIGHT=deepseek-chat
# 预算/成本开关（可选）：每日总 token 上限，超限自动降级
LLM_MAX_TOKENS_PER_DAY=

# 本地路径（可选，缺省有合理默认）
MF_DB_PATH=backend/data/mathfeynman.db
MF_CONTENT_ROOT=content
MF_HOST=127.0.0.1
MF_PORT=8000
MF_FRONT_PORT=5173
